# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: Public dashboard URL (for ngrok/Fly.io)
DASHBOARD_URL=https://your-domain.com/

# Optional: Flask secret key (auto-generated and persisted to a .secret_key file
# next to system.db if not set)
SECRET_KEY=

# Set to 0 once your first admin account exists to disable public sign-up.
ALLOW_REGISTRATION=1

# Required for the desktop app auto-login. Set this to a long random string and
# put the SAME value in the desktop machine's .env. Without it, /desktop-login
# is disabled (fail closed) and the desktop app shows the normal login page.
# Never use the same value as the deployed web app's SECRET_KEY.
DESKTOP_LOGIN_TOKEN=

# Set to 1 when the web app is served over HTTPS only (e.g. behind the Fly.io proxy)
SESSION_COOKIE_SECURE=0

# Freemium plan limits. Each new shop starts on the FREE plan (15 products,
# 3 users) and pays a one-time $10 fee to redeem a license key (Settings > Plan).
FREE_ITEM_LIMIT=15
FREE_USER_LIMIT=3

# Comma-separated organization ids that are permanently unlimited (grandfathered).
# Default "1" = admin@sokchhorn's original shop.
UNLIMITED_ORG_IDS=1

# Username (in any org) that can access the /admin/organizations panel, generate
# license keys, and is always exempt from plan limits. Set this in production.
SUPER_ADMIN_USERNAME=
